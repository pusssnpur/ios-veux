+/*
+ * VEUX Bluetooth HCI Controller IOKit emulation.
+ *
+ * Exposes an IOBluetoothHCIController-compatible service so that iOS
+ * userspace (bluetoothd) can talk to the WCN3990 over our GENI HS UART.
+ *
+ * NOTE (code-blind): the exact IOBluetoothHCIController user-client ABI
+ * (external method selectors, argument structures, notification format) is
+ * Apple-proprietary.  This implementation is a best-effort reconstruction
+ * from the public Bluetooth HCI spec and the patterns in VeuxSurface.cpp /
+ * VeuxFramebuffer.cpp.  It will need iteration once bluetoothd can be
+ * observed on a real boot.
+ *
+ * HCI command flow:
+ *   bluetoothd -> externalMethod(kVBTMethodSendHCI) -> veux_bt_hci_send()
+ *     -> UART -> WCN3990
+ * HCI event flow:
+ *   WCN3990 -> UART -> veux_bt_hci_poll() -> rx_handler()
+ *     -> sendAsyncResult64() -> bluetoothd
+ */
+#ifndef _VEUX_BLUETOOTH_HCI_H_
+#define _VEUX_BLUETOOTH_HCI_H_
+
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/IOCommandGate.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <libkern/c++/OSObject.h>
+
+/* External method selectors for VeuxBluetoothHCIRootUserClient.
+ * Estimated - verify against real bluetoothd traces. */
+enum {
+	kVBTMethodSendHCI		= 0,	/* input:  HCI command/ACL bytes (structure) */
+	kVBTMethodRegisterPort	= 1,	/* input:  mach port for async notifications */
+	kVBTMethodGetState		= 2,	/* output: controller state (scalar) */
+	kVBTMethodMax
+};
+
+/* HCI event types we forward to bluetoothd. */
+enum {
+	kHCIEventCommandComplete	= 0x0Fu,
+	kHCIEventCommandStatus		= 0x0Fu,
+	kHCIEventVendorSpecific		= 0xFFu,
+};
+
+class VeuxBluetoothHCI : public IOService {
+	OSDeclareDefaultStructors(VeuxBluetoothHCI)
+
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+
+	/* Called by the veux_bt.c RX poll path when a complete H4 frame arrives. */
+	static void hci_rx_handler(const uint8_t *data, uint32_t len, void *context);
+
+	/* Deliver an HCI event (or ACL data) to bluetoothd via async notification. */
+	void deliver_event(const uint8_t *data, uint32_t len);
+
+	bool is_enabled(void) const { return fEnabled; }
+
+private:
+	static VeuxBluetoothHCI *gInstance;
+	IOWorkLoop		*fWorkLoop;
+	IOCommandGate	*fCommandGate;
+	IOTimerEventSource	*fPollTimer;
+	IONotificationPort	*fNotifyPort;
+	mach_port_t		fNotifyMachPort;
+	IOAsyncReference64	fAsyncRef;
+	bool		fEnabled;
+	bool		fHaveEventMask;
+	uint8_t		fEventMask[8];
+};
+
+class VeuxBluetoothHCIRootUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(VeuxBluetoothHCIRootUserClient)
+
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector,
+	    IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn registerNotificationPort(mach_port_t port,
+	    UInt32 type, IOAsyncReference64 asyncRef) APPLE_KEXT_OVERRIDE;
+
+	IOReturn hci_send(const uint8_t *data, uint32_t len);
+
+private:
+	VeuxBluetoothHCI	*fOwner;
+	mach_port_t		fClientPort;
+	IOAsyncReference64	fClientAsyncRef;
+	bool		fIsOpen;
+
+	static IOExternalMethodDispatch sMethods[kVBTMethodMax];
+};
+
+#endif /* _VEUX_BLUETOOTH_HCI_H_ */
+
