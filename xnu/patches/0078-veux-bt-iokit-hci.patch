diff --git a/bsd/dev/veux_bt.h b/bsd/dev/veux_bt.h
new file mode 100644
index 0000000..7395960
--- /dev/null
+++ b/bsd/dev/veux_bt.h
@@ -0,0 +1,50 @@
+/*
+ * VEUX Bluetooth HCI C interface.
+ *
+ * veux_bt.c owns the WCN3990 GENI HS UART (SE1).  VeuxBluetoothHCI (IOKit)
+ * layers on top of it to expose an IOBluetoothHCIController-compatible service
+ * to iOS userspace (bluetoothd).
+ *
+ * All functions are safe to call from any kernel context; the UART itself is
+ * polled (no GIC interrupts), so veux_bt_hci_poll() must be called
+ * periodically to drain RX.
+ */
+#ifndef _VEUX_BT_H_
+#define _VEUX_BT_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Initialize the BT UART: map MMIO, vote clocks, program RCG to 7372800 Hz,
+ * configure GPIOs (61-64 mux qup01, 69 SW_CTRL high), init the GENI SE,
+ * send the QCA power pulses (0xC0@2400, 0xFC@115200), start RX at 115200.
+ * Returns true on success. */
+bool veux_bt_hci_init(void);
+
+/* Send an H4 frame (HCI command or ACL data) to the WCN3990 over UART.
+ * data[0] is the H4 type byte (0x01=cmd, 0x04=event, 0x02=ACL, 0x03=synchronous). */
+void veux_bt_hci_send(const uint8_t *data, uint32_t len);
+
+/* Register a callback for received H4 frames.  Called from the BT polling
+ * context; keep the handler short and non-blocking. */
+typedef void (*veux_bt_hci_rx_t)(const uint8_t *data, uint32_t len, void *context);
+void veux_bt_hci_set_rx_handler(veux_bt_hci_rx_t handler, void *context);
+
+/* Poll the UART RX FIFO once and dispatch complete H4 frames to the handler.
+ * Returns the number of RX bytes consumed.  Call periodically (e.g. from a
+ * workloop timer) if no IOKit consumer is present. */
+unsigned veux_bt_hci_poll(void);
+
+/* Stop the BT polling loop. */
+void veux_bt_hci_shutdown(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _VEUX_BT_H_ */
+
diff --git a/iokit/Kernel/arm/VeuxBluetoothHCI.cpp b/iokit/Kernel/arm/VeuxBluetoothHCI.cpp
new file mode 100644
index 0000000..6e29a85
--- /dev/null
+++ b/iokit/Kernel/arm/VeuxBluetoothHCI.cpp
@@ -0,0 +1,308 @@
+/*
+ * VEUX Bluetooth HCI Controller IOKit emulation.
+ *
+ * See VeuxBluetoothHCI.h for design notes and ABI caveats.
+ */
+#include "VeuxBluetoothHCI.h"
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/IOCommandGate.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/system.h>
+#include <libkern/c++/OSObject.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <mach/mach_types.h>
+#include <mach/message.h>
+#include <sys/proc.h>
+#include <bsd/dev/veux_bt.h>
+
+#define kVBTServiceName		"IOBluetoothHCIController"
+#define kVBTPropertyVendorID	"idVendor"
+#define kVBTPropertyProductID	"idProduct"
+#define kVBTPropertyBDAddr	"BluetoothAddress"
+
+#define VBT_POLL_MS		10
+
+/* Fake BD address for the WCN3990 (locally administered, random). */
+static const uint8_t kVBTBDAddr[6] = { 0x02, 0x1A, 0x2B, 0x3C, 0x4D, 0x5E };
+
+/* Fake local version info (Bluetooth 5.2, WCN3990-like). */
+static const uint8_t kVBTLocalVersion[] = { 0x09, 0x0C, 0x00, 0x00, 0x00, 0x00 };
+
+VeuxBluetoothHCI *VeuxBluetoothHCI::gInstance = NULL;
+
+OSDefineMetaClassAndStructors(VeuxBluetoothHCI, IOService)
+OSDefineMetaClassAndStructors(VeuxBluetoothHCIRootUserClient, IOUserClient)
+
+IOExternalMethodDispatch VeuxBluetoothHCIRootUserClient::sMethods[kVBTMethodMax] = {
+	/* kVBTMethodSendHCI: structure input, no checks */
+	{ (IOExternalMethodAction) &VeuxBluetoothHCIRootUserClient::hci_send_ext,
+	    0, 0, 0, 0 },
+	/* kVBTMethodRegisterPort: 3 scalar inputs (port, type, refcon) */
+	{ (IOExternalMethodAction) &VeuxBluetoothHCIRootUserClient::register_port_ext,
+	    3, 0, 0, 0 },
+	/* kVBTMethodGetState: 1 scalar output */
+	{ (IOExternalMethodAction) &VeuxBluetoothHCIRootUserClient::get_state_ext,
+	    0, 0, 1, 0 },
+};
+
+/* ---------------- VeuxBluetoothHCI ---------------- */
+
+bool
+VeuxBluetoothHCI::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+
+	/* Publish properties so bluetoothd can identify the controller. */
+	setProperty(kVBTPropertyVendorID, 0x05AC); /* Apple vendor ID */
+	setProperty(kVBTPropertyProductID, 0x8290); /* placeholder product ID */
+	setProperty(kVBTPropertyBDAddr, kVBTBDAddr, 6 * 8);
+	setProperty("BluetoothHCIController", true);
+
+	/* Register the service so IOService matching can find us. */
+	registerService();
+
+	gInstance = this;
+	fWorkLoop = getWorkLoop();
+	fCommandGate = IOCommandGate::commandGate(this);
+	if (!fCommandGate || fWorkLoop->addEventSource(fCommandGate) != kIOReturnSuccess) {
+		return false;
+	}
+
+	/* Poll timer: drain UART RX periodically. */
+	fPollTimer = IOTimerEventSource::timerEventSource(this,
+	    (IOTimerEventSource::Action) &VeuxBluetoothHCI::poll_timer);
+	if (!fPollTimer || fWorkLoop->addEventSource(fPollTimer) != kIOReturnSuccess) {
+		return false;
+	}
+	fPollTimer->setTimeoutMS(VBT_POLL_MS);
+
+	/* Connect to the UART driver (init already done by bt_thread from
+	 * veux_ufs.c; just set the RX handler here). */
+	veux_bt_hci_set_rx_handler(&VeuxBluetoothHCI::hci_rx_handler, this);
+
+	fEnabled = true;
+	fHaveEventMask = false;
+	printf("VEUX BT-HCI: service registered as %s\n", kVBTServiceName);
+	return true;
+}
+
+void
+VeuxBluetoothHCI::stop(IOService *provider)
+{
+	fEnabled = false;
+	if (fPollTimer) {
+		fPollTimer->cancelTimeout();
+		fWorkLoop->removeEventSource(fPollTimer);
+	}
+	if (fCommandGate) {
+		fWorkLoop->removeEventSource(fCommandGate);
+	}
+	veux_bt_hci_shutdown();
+	gInstance = NULL;
+	IOService::stop(provider);
+}
+
+void
+VeuxBluetoothHCI::poll_timer(__unused IOTimerEventSource *sender, __unused void *context)
+{
+	if (!gInstance || !gInstance->fEnabled) {
+		return;
+	}
+	unsigned n = veux_bt_hci_poll();
+	if (n) {
+		printf("VEUX BT-HCI: polled %u RX bytes\n", n);
+	}
+	fPollTimer->setTimeoutMS(VBT_POLL_MS);
+}
+
+void
+VeuxBluetoothHCI::hci_rx_handler(const uint8_t *data, uint32_t len, void *context)
+{
+	VeuxBluetoothHCI *self = (VeuxBluetoothHCI *)context;
+	if (!self || !self->fEnabled) {
+		return;
+	}
+	self->deliver_event(data, len);
+}
+
+void
+VeuxBluetoothHCI::deliver_event(const uint8_t *data, uint32_t len)
+{
+	if (!fNotifyMachPort) {
+		return; /* no one listening */
+	}
+
+	/* Build an async notification: [type u32][len u32][data...] */
+	uint32_t header[2] = { kHCIEventVendorSpecific, (uint32_t)len };
+	uint32_t values[2 + (512 / 4)];
+	uint32_t count = 2;
+	for (uint32_t i = 0; i < len && i < 512; i += 4) {
+		uint32_t word = 0;
+		for (uint32_t j = 0; j < 4 && (i + j) < len; j++) {
+			word |= (uint32_t)data[i + j] << (8 * j);
+		}
+		values[count++] = word;
+	}
+
+	setAsyncReference64(fAsyncRef, fNotifyMachPort, 0, 0, current_task());
+	sendAsyncResult64WithOptions(fAsyncRef, kIOReturnSuccess,
+	    (io_user_reference_t *)values, count, 0);
+}
+
+/* ---------------- VeuxBluetoothHCIRootUserClient ---------------- */
+
+bool
+VeuxBluetoothHCIRootUserClient::start(IOService *provider)
+{
+	fOwner = OSDynamicCast(VeuxBluetoothHCI, provider);
+	if (!fOwner || !fOwner->is_enabled()) {
+		return false;
+	}
+	if (!IOUserClient::start(provider)) {
+		return false;
+	}
+	fClientPort = MACH_PORT_NULL;
+	fIsOpen = true;
+	printf("VEUX BT-HCI: user client opened\n");
+	return true;
+}
+
+IOReturn
+VeuxBluetoothHCIRootUserClient::externalMethod(uint32_t selector,
+    IOExternalMethodArguments *args,
+    IOExternalMethodDispatch *dispatch,
+    OSObject *target,
+    void *reference)
+{
+	if (!fOwner || !fIsOpen) {
+		return kIOReturnNotAttached;
+	}
+
+	switch (selector) {
+	case kVBTMethodSendHCI: {
+		/* args->structureInput = HCI command/ACL bytes, structureInputSize = len */
+		if (args->structureInput && args->structureInputSize > 0) {
+			const uint8_t *cmd = (const uint8_t *)args->structureInput;
+			/* Forward HCI commands (type 0x01) to the UART. */
+			if (cmd[0] == 0x01u) {
+				veux_bt_hci_send(cmd, args->structureInputSize);
+			}
+			/* Answer locally-answerable commands synchronously. */
+			if (args->structureInputSize >= 4u && cmd[0] == 0x01u) {
+				uint16_t opcode = (uint16_t)cmd[2] | ((uint16_t)cmd[3] << 8);
+				if (opcode == HCI_OP_RESET) {
+					/* HCI_Reset: answer Command Complete locally. */
+					uint8_t cc[] = { 0x04u, 0x0Eu, 0x04u, 0x01u, 0x03u, 0x0Cu, 0x00u };
+					fOwner->deliver_event(cc, sizeof(cc));
+				} else if (opcode == HCI_OP_READ_LOCAL_VER) {
+					uint8_t cc[] = { 0x04u, 0x0Eu, 0x0Cu, 0x01u, 0x10u,
+					    0x09u, 0x0Cu, 0x00u, 0x00u, 0x00u, 0x00u, 0x00u };
+					fOwner->deliver_event(cc, sizeof(cc));
+				} else if (opcode == HCI_OP_READ_BD_ADDR) {
+					uint8_t cc[] = { 0x04u, 0x0Eu, 0x07u, 0x01u, 0x09u, 0x10u,
+					    0x02u, 0x1Au, 0x2Bu, 0x3Cu, 0x4Du, 0x5Eu };
+					fOwner->deliver_event(cc, sizeof(cc));
+				} else if (opcode == HCI_OP_SET_EVENT_MASK) {
+					uint8_t cc[] = { 0x04u, 0x0Eu, 0x04u, 0x01u, 0x01u, 0x0Cu, 0x00u };
+					fOwner->deliver_event(cc, sizeof(cc));
+					if (args->structureInputSize >= 12) {
+						for (int i = 0; i < 8; i++) {
+							fOwner->fEventMask[i] = cmd[4 + i];
+						}
+						fOwner->fHaveEventMask = true;
+					}
+				}
+			}
+		}
+		return kIOReturnSuccess;
+	}
+	case kVBTMethodRegisterPort: {
+		/* args->scalarInput[0] = mach port, [1] = type, [2] = refcon */
+		if (args->scalarInputCount >= 1) {
+			fClientPort = (mach_port_t)args->scalarInput[0];
+			fOwner->fNotifyMachPort = fClientPort;
+			setAsyncReference64(fClientAsyncRef, fClientPort, 0, 0, current_task());
+			fOwner->fAsyncRef = fClientAsyncRef;
+		}
+		return kIOReturnSuccess;
+	}
+	case kVBTMethodGetState: {
+		if (args->scalarOutputCount >= 1) {
+			args->scalarOutput[0] = fOwner->fEnabled ? 1u : 0u;
+			args->scalarOutputSize = 1;
+		}
+		return kIOReturnSuccess;
+	}
+	default:
+		return kIOReturnBadArgument;
+	}
+}
+
+IOReturn
+VeuxBluetoothHCIRootUserClient::hci_send_ext(__unused OSObject *target,
+    __unused void *reference, uint32_t selector,
+    IOExternalMethodArguments *args)
+{
+	if (!args->structureInput || args->structureInputSize == 0) {
+		return kIOReturnBadArgument;
+	}
+	return ((VeuxBluetoothHCIRootUserClient *)target)->hci_send(
+	    (const uint8_t *)args->structureInput, args->structureInputSize);
+}
+
+IOReturn
+VeuxBluetoothHCIRootUserClient::register_port_ext(__unused OSObject *target,
+    __unused void *reference, uint32_t selector,
+    IOExternalMethodArguments *args)
+{
+	if (args->scalarInputCount < 1) {
+		return kIOReturnBadArgument;
+	}
+	return ((VeuxBluetoothHCIRootUserClient *)target)->registerNotificationPort(
+	    (mach_port_t)args->scalarInput[0], 0, 0);
+}
+
+IOReturn
+VeuxBluetoothHCIRootUserClient::get_state_ext(__unused OSObject *target,
+    __unused void *reference, uint32_t selector,
+    IOExternalMethodArguments *args)
+{
+	if (args->scalarOutputCount < 1) {
+		return kIOReturnBadArgument;
+	}
+	args->scalarOutput[0] = ((VeuxBluetoothHCIRootUserClient *)target)->fOwner
+	    ? (((VeuxBluetoothHCIRootUserClient *)target)->fOwner->fEnabled ? 1u : 0u)
+	    : 0u;
+	args->scalarOutputSize = 1;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+VeuxBluetoothHCIRootUserClient::hci_send(const uint8_t *data, uint32_t len)
+{
+	if (!fIsOpen || !data || !len) {
+		return kIOReturnBadArgument;
+	}
+	veux_bt_hci_send(data, len);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+VeuxBluetoothHCIRootUserClient::registerNotificationPort(mach_port_t port,
+    __unused UInt32 type, IOAsyncReference64 asyncRef)
+{
+	fClientPort = port;
+	fClientAsyncRef = asyncRef;
+	if (fOwner) {
+		fOwner->fNotifyMachPort = port;
+		fOwner->fAsyncRef = asyncRef;
+	}
+	return kIOReturnSuccess;
+}
