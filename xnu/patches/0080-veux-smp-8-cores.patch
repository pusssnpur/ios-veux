--- a/pexpert/pexpert/arm64/VEUX.h
+++ b/pexpert/pexpert/arm64/VEUX.h
@@ -17,8 +17,13 @@
 
 #define VEUX                     1
 
-/* Six homogeneous A55s; cpus=N is clamped here until A78/AMP is audited. */
-#define VEUX_SMP_MAX_CPUS         6
+/*
+ * All eight cores (six A55 + two A78) as one homogeneous SMP cluster:
+ * cpus=N is clamped here. Same ISA level (ARMv8.2), 64-byte lines, PSCI
+ * CPU_ON; the scheduler does not know the A78s are faster (no AMP/P-E
+ * clusters yet).
+ */
+#define VEUX_SMP_MAX_CPUS         8
 
 #define ARM_ARCH_TIMER
 #define __ARM_ARCH__              8
